# WinDbgMCP .gitignore

# Tasks directory & internal planning logs
tasks/

# Binaries directory contents
binaries/*
!binaries/.gitkeep
!binaries/extensions/
!binaries/extensions/x64/
!binaries/extensions/x64/*
!binaries/extensions/x86/
!binaries/extensions/x86/*
binaries/extensions/*/*.pdb
binaries/extensions/*/*.exp
binaries/extensions/*/*.lib

# Python byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
# dist/

downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.hypothesis/

# Crash dumps & log artifacts
*.dmp
*.mdmp
*.hdmp
*.log
*.tmp

# Custom examples, local test suites, reports & scratchpads
examples/
tests/
reports/
analysis/

# IDEs, Editors & OS Files
.vs/
.idea/
.vscode/
*.user
*.suo
*.userosv
*.sln.docstates
.DS_Store
Thumbs.db
